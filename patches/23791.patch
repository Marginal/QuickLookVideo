 create mode 100644 tests/ref/fate/notchlc-alpha-blocks
 create mode 100644 tests/ref/fate/notchlc-alpha-macroblocks
 create mode 100644 tests/ref/fate/notchlc-alpha-ramp
 create mode 100644 tests/ref/fate/notchlc-alpha-ramp-oddsize
 create mode 100644 tests/ref/fate/notchlc-chroma-alpha

